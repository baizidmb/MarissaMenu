import re
import json

with open('scratch/lines_out.txt', 'r', encoding='utf-8') as f:
    raw_lines = [line.split(': ', 1)[1].strip() for line in f if ': ' in line]

# Let's inspect category headers (lines that are uppercase or section titles)
category_candidates = []
for i, l in enumerate(raw_lines):
    if len(l) > 3 and (l.isupper() or 'MENIU' in l or 'PREPARATE' in l or 'PIZZA' in l or 'CIORBE' in l or 'SALATE' in l or 'GARNITURI' in l or 'DESERT' in l or 'VINURI' in l or 'BĂUTURI' in l or 'BEVERAGES' in l or 'PASTE' in l or 'SOPA' in l or 'PLATOURI' in l or 'MIC DEJUN' in l):
        category_candidates.append((i+1, l))

with open('scratch/categories_found.txt', 'w', encoding='utf-8') as out:
    for idx, cat in category_candidates:
        out.write(f"Line {idx}: {cat}\n")

print(f"Found {len(category_candidates)} potential category headers!")
